{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "helpers:pinGitHubActionDigests", ":semanticCommits"],
  "forkProcessing": "enabled",
  "baseBranchPatterns": ["main"],
  "enabledManagers": ["gradle", "gradle-wrapper", "github-actions", "custom.regex"],
  "dependencyDashboard": true,
  "schedule": ["* 0-11 * * 1"],
  "prConcurrentLimit": 5,
  "prHourlyLimit": 2,
  "labels": ["dependencies"],
  "semanticCommitType": "chore",
  "semanticCommitScope": "deps",
  "automerge": false,
  "minimumReleaseAge": "3 days",
  "minimumReleaseAgeBehaviour": "timestamp-optional",
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^gradle\\.properties$/"],
      "matchStrings": [
        "(?:^|\\n)# renovate: datasource=(?<datasource>maven) depName=(?<depName>[^\\s]+) registryUrl=(?<registryUrl>https://[^\\s]+)(?: depType=(?<depType>[^\\s]+))?\\r?\\n[a-z0-9.]+\\.version(?:\\.[0-9.]+)?=(?<currentValue>[^\\s]+)"
      ],
      "versioningTemplate": "maven"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^\\.github/workflows/renovate-validation\\.yml$/"],
      "matchStrings": [
        "# renovate: datasource=npm depName=renovate\\r?\\n\\s+RENOVATE_VERSION: \"(?<currentValue>[^\"]+)\""
      ],
      "datasourceTemplate": "npm",
      "depNameTemplate": "renovate",
      "versioningTemplate": "npm"
    }
  ],
  "packageRules": [
    {
      "description": "Annotated properties are owned by the custom manager",
      "matchManagers": ["gradle"],
      "matchFileNames": ["gradle.properties"],
      "enabled": false
    },
    {
      "description": "Group routine workflow updates across GitHub and Forgejo",
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["minor", "patch", "pin", "pinDigest", "digest"],
      "groupName": "CI actions"
    },
    {
      "description": "Group routine Gradle and library updates",
      "matchManagers": ["gradle", "gradle-wrapper", "custom.regex"],
      "matchDatasources": ["maven", "gradle-version"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "Gradle dependencies"
    },
    {
      "description": "Review Kotlin plugins and the Fabric Kotlin runtime together",
      "matchPackageNames": ["org.jetbrains.kotlin:*", "org.jetbrains.kotlin.*:*", "net.fabricmc:fabric-language-kotlin"],
      "groupName": "Kotlin",
      "separateMajorMinor": false
    },
    {
      "description": "Minecraft ports and the Minecraft-provided native ABI need manual changes",
      "matchPackageNames": ["com.mojang:minecraft", "org.lwjgl:*"],
      "enabled": false
    },
    {
      "description": "Fabric Loader and its minimum runtime constraint are managed manually",
      "matchPackageNames": ["net.fabricmc:fabric-loader", "net.fabricmc:fabric-loader-junit"],
      "enabled": false
    },
    {
      "description": "Keep Java on the versions used by the build and Minecraft targets",
      "matchDatasources": ["java-version"],
      "enabled": false
    },
    {
      "description": "Keep Fabric API, hm-api, and RenderChest on their current Minecraft suffix",
      "matchPackageNames": ["net.fabricmc.fabric-api:fabric-api", "net.azureaaron:hm-api", "net.azureaaron:render-chest"],
      "versionCompatibility": "^(?<version>[^+]+)\\+(?<compatibility>26\\..+)$"
    },
    {
      "description": "Allow RenderChest prereleases for the 26.3 target",
      "matchPackageNames": ["net.azureaaron:render-chest"],
      "matchDepTypes": ["26.3"],
      "ignoreUnstable": false
    },
    {
      "description": "Mod Menu majors follow Minecraft releases, including their prereleases",
      "matchPackageNames": ["com.terraformersmc:modmenu"],
      "ignoreUnstable": false
    },
    {
      "matchPackageNames": ["com.terraformersmc:modmenu"],
      "matchDepTypes": ["26.1.2"],
      "allowedVersions": "/^18\\./"
    },
    {
      "matchPackageNames": ["com.terraformersmc:modmenu"],
      "matchDepTypes": ["26.2"],
      "allowedVersions": "/^20\\./"
    },
    {
      "matchPackageNames": ["com.terraformersmc:modmenu"],
      "matchDepTypes": ["26.3"],
      "allowedVersions": "/^21\\./"
    },
    {
      "description": "Extract only Iris versions for the matching Minecraft target and Fabric loader",
      "matchPackageNames": ["maven.modrinth:iris"],
      "matchDepTypes": ["26.1.2"],
      "extractVersion": "^(?<version>.+)\\+26\\.1-fabric$"
    },
    {
      "matchPackageNames": ["maven.modrinth:iris"],
      "matchDepTypes": ["26.2"],
      "extractVersion": "^(?<version>.+)\\+26\\.2-fabric$"
    },
    {
      "matchPackageNames": ["maven.modrinth:iris"],
      "matchDepTypes": ["26.3"],
      "extractVersion": "^(?<version>.+)\\+26\\.3-fabric$"
    },
    {
      "description": "Extract only Sodium versions for the matching Minecraft target and Fabric loader",
      "matchPackageNames": ["maven.modrinth:sodium"],
      "matchDepTypes": ["26.1.2"],
      "extractVersion": "^mc26\\.1\\.2-(?<version>.+)-fabric$"
    },
    {
      "matchPackageNames": ["maven.modrinth:sodium"],
      "matchDepTypes": ["26.2"],
      "extractVersion": "^mc26\\.2-(?<version>.+)-fabric$"
    },
    {
      "matchPackageNames": ["maven.modrinth:sodium"],
      "matchDepTypes": ["26.3"],
      "extractVersion": "^mc26\\.3-(?<version>.+)-fabric$"
    },
    {
      "description": "Forgejo artifact uploads require the v4 protocol",
      "matchManagers": ["github-actions"],
      "matchFileNames": [".forgejo/workflows/**"],
      "matchPackageNames": ["forgejo/upload-artifact"],
      "allowedVersions": "/^v?4(?:\\.|$)/"
    },
    {
      "description": "The Renovate validator currently requires Node 24",
      "matchManagers": ["github-actions"],
      "matchFileNames": [".github/workflows/renovate-validation.yml"],
      "matchPackageNames": ["node"],
      "allowedVersions": "/^24(?:\\.|$)/"
    }
  ]
}
